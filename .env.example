# Django 配置
# ============================================
# 安全警告：不要在生产环境中使用默认值！
# 请复制此文件为 .env 并填写真实的配置值
# ============================================

# Django 密钥（必须修改！）
# 生成新密钥：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# 调试模式（生产环境必须设置为 False）
DEBUG=False

# 允许的主机（用逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS 允许的源（用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 数据库配置
# ============================================
DB_NAME=mydjangodb
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# OpenAI 配置（用于 AI 分析用例功能）
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3

# Qwen (阿里云 DashScope) 配置
# ============================================
DASHSCOPE_API_KEY=your-dashscope-api-key-here
QWEN_MODEL_NAME=qwen3-coder-plus

# 前端 API 配置（可选，用于前端开发）
# ============================================
# REACT_APP_API_BASE_URL=http://localhost:8000/api
