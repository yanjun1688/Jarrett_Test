# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg

# Virtual Environment
venv/
.env/
.venv/
env/

# Environment Variables (SENSITIVE!)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# Node.js
node_modules/

# Build outputs
dist/
build/
out/

# Coverage & Testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
pytest_cache/
coverage.json
.coveragerc

# Django
*.mo
*.pot
*.sqlite3
db.sqlite3
staticfiles/

# Media 运行时数据（不跟踪）
media/
media/agent_knowledge/
media/embeddings_cache/
media/ui_test_screenshots/
media/ui_test_work/

# IDE / Editor
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# AI Agent 配置目录
.agent/
.agents/
.claude/
.cline/
.kiro/

# MCP / Tools
.playwright-mcp/
.mypy_cache/

# Hypothesis (property-based testing)
.hypothesis/

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
tmp*.yaml
tmp*.py
frontend/download-*/
nul

# Local scripts (not needed in repo)
verify_recorder.py
restart_server.ps1
check_coverage.py
skills-lock.json
/package-lock.json

# Backups
*.bak
*.backup
backups/

# Documentation (keep README.md only)
*.md
!README.md
docs/

# Test directories (only filter actual test code directories)
tests/
**/tests/
tests/e2e/
tests/unit/
tests/integration/

# Temporary test scripts (local debug)
validate_*.py
debug_*.py
tmp*.py

# App-level test files (not in tests/ directory)
testmanager_app/test_*.py
test_ui_app/test_*.py
test_ai_agent/test_*.py

# MCP builder temp
=mcp-builder/
agent-browser.json

# Pyright config
pyrightconfig.json
pyright_errors.json

# Context data (runtime)
context_data/

# Start scripts (local only)
start.py
start.sh
start.ps1

# Data directory
data/

# Temporary/one-time scripts (local only)
cleanup_deprecated.py
create_migration_template.py
REMOVE_TESTFLOW_MODELS_migration_example.py

# Environment check timestamps
.pip_check_timestamp
.playwright_check_timestamp