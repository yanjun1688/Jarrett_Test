# ============================================
# JTest Project .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg

# Virtual Environment
venv/
.env/
.venv/
env/

# Environment Variables (SENSITIVE!)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# Node.js
node_modules/

# Build outputs
dist/
build/
out/

# Coverage & Testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
pytest_cache/

# Django
*.mo
*.pot
*.sqlite3
db.sqlite3
media/
staticfiles/

# IDE / Editor
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
*~

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
tmp*.yaml
tmp*.py
frontend/download-*/

# Local scripts (not needed in repo)
verify_recorder.py
restart_server.ps1

# Backups
*.bak
*.backup
backups/

# Documentation (keep README.md only)
*.md
!README.md

# Test directories
testmanager_app/tests/
testmanager_app/test_scripts/

# Misc
xx.txt
testmanager/xx.txt
控制台日志.txt
